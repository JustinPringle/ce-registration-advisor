+# Civil Engineering (Augmented) — standalone programme definition.
+#
+# A complete FIVE-year programme in its own right. Level 1 is spread over two
+# calendar years (Years 1-2); Levels 2-4 follow the mainstream Civil curriculum,
+# copied here so this file stands alone. Where a mainstream module required a
+# first-year module that has an augmented twin, the requirement is rewritten to
+# accept EITHER twin (see THE AUGMENTED RULE below).
+#
+# Grammar is identical to civil.yaml (regadvisor_engine.eval_term). yaml.safe_load
+# returns exactly the dicts and lists the engine reads; no free-text parsing.
+#
+# Term shapes (a module's `prereqs` is a list, AND-ed together):
+#   CODE                       course passed
+#   {code: X, min_mark: N}     best mark >= N carries (a 40-49 carry; no full pass)
+#   {code: X, soft: true}      recommended only — never blocks
+#   {all: [...]}               every term holds
+#   {any: [...]}               at least one holds  <-- aug|mainstream substitution
+#   {any_n: N, of: [...]}      at least N hold
+#   {min_year: N}              student in year N of study or later
+#   {min_sem: N}               registered for >= N semesters
+#   {min_credits: N, level: L} N passed credits (optionally at NQF level L)
+#   {review: "text"}           NEVER auto-clears — routes the module to a human
+#
+# THE AUGMENTED RULE (handbook). Each augmented module has a mainstream twin.
+#   1. Passing EITHER twin satisfies a downstream prerequisite — encoded with the
+#      reusable {any: [aug, main]} anchors under `_twins` below.
+#   2. FAILING an augmented module obliges the student to take the mainstream
+#      twin (different credits/notional hours). That enforcement is advisor logic
+#      (a later step); the `equivalences` block is the data it reads.
+#
+# LEVEL derives from the module CODE (ENCV2SA -> 2), not the `year` field, so
+# progression gates are correct regardless of year numbering. `year` is a display
+# hint only; the 5-year mapping (mainstream L2->Y3, L3->Y4, L4->Y5) awaits the
+# augmented Years 3-5 handbook — see OPEN DECISIONS.
+
+programme:
+  code: ENG-CIVIL-AUG
+  name: Civil Engineering (Augmented)
+regulation_years: 5
+external_prereqs:
+  - PHYS110
+# Augmented <-> mainstream twins (handbook equivalence table). Data only.
+equivalences:
+  - {augmented: MATH160, mainstream: MATH131}   # Eng Mathematics 1A
+  - {augmented: MATH161, mainstream: MATH141}   # Eng Mathematics 1B
+  - {augmented: PHYS160, mainstream: PHYS151}   # Eng Physics 1A
+  - {augmented: PHYS163, mainstream: PHYS152}   # Eng Physics 1B
+  - {augmented: ENME160, mainstream: ENME1DR}   # Engineering Drawing
+  - {augmented: ENCH160, mainstream: ENCH1TC}   # Technical Communication
+  - {augmented: ENAG161, mainstream: ENME1EM}   # Engineering Materials
+  - {augmented: ENAG160, mainstream: ENCV1ED}   # Engineering Design (Civil branch)
+
+# Reusable "either twin passed" terms (full pass of aug OR mainstream). Defined
+# once, referenced by the downstream modules and the capstone gate. The current
+# engine ignores unknown top-level keys, so this block only carries anchors.
+_twins:
+  - &TW_DRAW {any: [ENME160, ENME1DR]}   # Drawing
+  - &TW_TC   {any: [ENCH160, ENCH1TC]}   # Technical Communication
+  - &TW_M1A  {any: [MATH160, MATH131]}   # Mathematics 1A
+  - &TW_P1A  {any: [PHYS160, PHYS151]}   # Physics 1A
+  - &TW_MAT  {any: [ENAG161, ENME1EM]}   # Materials
+  - &TW_DES  {any: [ENAG160, ENCV1ED]}   # Design
+  - &TW_M1B  {any: [MATH161, MATH141]}   # Mathematics 1B
+  - &TW_P1B  {any: [PHYS163, PHYS152]}   # Physics 1B
+
+# Policy, as data. Inherited from mainstream Civil unchanged, pending augmented-
+# specific sign-off (D1: augmented Level 1 spans four semesters, not two).
+rules:
+  concession:
+    min_gpa: 55
+    max_missing: 1
+    prereq_floor: 45
+  autoclear:
+    enabled: true
+    min_wam: 55
+    carry_band: [46, 49]
+    single_miss_only: true
+    allowed_standings: [green, orange]
+    rule_id: CAC-v1
+  credit_cap:
+    green: null
+    orange: 48
+    red: 32
+    exclude: 0
+    ERS-ORANGE-SEM: 56
+    ERS-RED-SECOND: 24
+  ers:
+    # Progression thresholds by semesters completed (robot_system_logic Section 3),
+    # augmented stream. Row = [min_progression, normal, p75_of_normal].
+    progression:
+      1:  [0,   16,  0]
+      2:  [32,  64,  48]
+      3:  [56,  104, 78]
+      4:  [96,  176, 132]
+      5:  [144, 240, 180]
+      6:  [192, 304, 228]
+      7:  [240, 368, 276]
+      8:  [288, 432, 324]
+      9:  [336, 504, null]
+      10: [384, 576, null]
+      11: [432, null, null]
+      12: [480, null, null]
+      13: [528, null, null]
+      14: [576, null, null]
+
