+# Civil Engineering — programme definition and prerequisite rules.
+#
+# Authored directly in the engine's term grammar (regadvisor_engine.eval_term),
+# so no free-text parsing happens at runtime. yaml.safe_load returns exactly the
+# dicts and lists the engine reads.
+#
+# Term shapes (a module's `prereqs` is a list, AND-ed together):
+#   CODE                       course passed
+#   {code: X, min_mark: N}     best mark >= N carries (a 40-49 carry; no full pass)
+#   {code: X, soft: true}      recommended only — never blocks
+#   {all: [...]}               every term holds
+#   {any: [...]}               at least one holds
+#   {any_n: N, of: [...]}      at least N hold
+#   {min_year: N}              student in year N of study or later
+#   {min_sem: N}               registered for >= N semesters
+#   {min_credits: N, level: L} N passed credits (optionally at NQF level L)
+#   {review: "text"}           NEVER auto-clears — routes the module to a human
+#
+# `coreqs` are recorded for fidelity but the advice engine does not gate on them
+# (co-requisites are taken in the same semester). They document intent only.
+#
+# SEMANTIC NOTES:
+#   * "(40%)" carries. The sheet lets a 40–49% result carry into the next module.
+#     Authored as {code: X, min_mark: 40}: a mark >= 40 satisfies the prereq, no
+#     full pass required. A bare code term still requires a pass (>=50).
+#   * "(DP)" prereqs. Encoded as a plain pass requirement (stricter than "has DP")
+#     — still open for your sign-off.
+external_prereqs:
+  - PHYS110
